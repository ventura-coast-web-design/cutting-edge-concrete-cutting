---
layout: base.njk
title: "Service Areas - Cutting Edge Concrete Cutting"
description: "Find concrete cutting services in your area. We serve Los Angeles, Orange, Ventura, Riverside, San Bernardino, Kern, Tulare, Fresno, Kings, and Madera Counties."
subtitle: "Professional Concrete Services"
cta_text: "Get a Free Quote"
cta_url: "/contact/"
---

{% include "hero.njk" %}

<main class="service-areas-page">
  <div class="container">
    <h1>Service Areas</h1>
    <p class="page-subtitle">Professional concrete cutting, sawing, and coring services throughout Southern and Central California</p>
    
    <div class="counties-grid">
      {% for area in serviceAreas %}
      <div class="county-card">
        <h2>{{ area.county }}</h2>
        <p class="county-description">{{ area.meta.description }}</p>
        
        <div class="cities-section">
          <h3>Cities We Serve:</h3>
          <ul class="cities-list" data-county="{{ area.slug }}">
            {% for city in area.serviceArea %}
            <li class="city-item" {% if loop.index > 10 %}style="display: none;"{% endif %}><a href="/service-areas/{{ area.slug }}/{{ city.slug }}/">{{ city.name }}</a></li>
            {% endfor %}
          </ul>
          {% if area.serviceArea.length > 10 %}
          <button class="see-more-btn" data-county="{{ area.slug }}">
            <span class="see-more-text">See More Cities</span>
            <span class="see-less-text" style="display: none;">See Less</span>
          </button>
          {% endif %}
        </div>
        
        <a href="/service-areas/{{ area.slug }}/" class="btn btn-primary">View {{ area.county }} Services</a>
      </div>
      {% endfor %}
    </div>
    
    <div class="cta-section">
      <h2>Don't See Your City?</h2>
      <p>We serve many more areas throughout California. Contact us to see if we can help with your concrete cutting project.</p>
      <a href="/contact/" class="btn btn-primary">Get a Free Quote</a>
    </div>
  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const seeMoreButtons = document.querySelectorAll('.see-more-btn');
  
  seeMoreButtons.forEach(button => {
    button.addEventListener('click', function() {
      const countySlug = this.getAttribute('data-county');
      const citiesList = document.querySelector(`[data-county="${countySlug}"]`);
      const hiddenCities = citiesList.querySelectorAll('.city-item[style*="display: none"]');
      const seeMoreText = this.querySelector('.see-more-text');
      const seeLessText = this.querySelector('.see-less-text');
      
      if (hiddenCities.length > 0) {
        // Show all hidden cities
        hiddenCities.forEach(city => {
          city.style.display = 'block';
        });
        seeMoreText.style.display = 'none';
        seeLessText.style.display = 'inline';
        this.setAttribute('data-expanded', 'true');
      } else {
        // Hide cities beyond the first 10
        const allCities = citiesList.querySelectorAll('.city-item');
        allCities.forEach((city, index) => {
          if (index >= 10) {
            city.style.display = 'none';
          }
        });
        seeMoreText.style.display = 'inline';
        seeLessText.style.display = 'none';
        this.setAttribute('data-expanded', 'false');
      }
    });
  });
});
</script>
